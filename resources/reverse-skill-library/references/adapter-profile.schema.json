{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsl.local/schemas/adapter-profile.schema.json",
  "title": "RSL agent discovery profile v2",
  "type": "object",
  "required": ["schema_version", "harness", "capability_states", "fallback_strategy", "verification"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "harness": {
      "type": "object",
      "required": ["id", "profile_status", "last_reviewed", "compatibility_basis", "documentation_urls", "discovery_hints", "declared_capabilities"],
      "properties": {
        "id": {"enum": ["claude-code", "cursor", "codex", "gemini-cli", "copilot", "opencode", "cline", "windsurf", "grok-build", "generic"]},
        "profile_status": {"const": "discovery_hints_only"},
        "last_reviewed": {"type": "string", "format": "date"},
        "compatibility_basis": {"type": "string", "minLength": 1},
        "documentation_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "discovery_hints": {"type": "object", "required": ["skill_paths", "rules_paths", "hook_configuration_hints", "subagent_configuration_hints"], "properties": {"skill_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "rules_paths": {"type": "array", "items": {"type": "string"}}, "hook_configuration_hints": {"type": "array", "items": {"type": "string"}}, "subagent_configuration_hints": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "declared_capabilities": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["documented", "partial", "unsupported", "unknown", "probe_required"]}}
      },
      "additionalProperties": false
    },
    "capability_states": {"const": ["available", "partial", "unavailable", "unknown"]},
    "fallback_strategy": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "verification": {"type": "object", "required": ["runtime_verified", "required_before_claiming_compatibility", "note"], "properties": {"runtime_verified": {"const": false}, "required_before_claiming_compatibility": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "note": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
